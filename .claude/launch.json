{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "trunk",
      "runtimeArgs": ["serve", "--config", "openecraft/Trunk.toml"],
      "port": 8080
    },
    {
      "name": "web-fresh",
      "runtimeExecutable": "trunk",
      "runtimeArgs": ["serve", "--config", "openecraft/Trunk.toml", "--port", "8081", "--dist", "target/dist-fresh"],
      "port": 8081
    },
    {
      "name": "parts-manager-web",
      "runtimeExecutable": "trunk",
      "runtimeArgs": ["serve", "--config", "parts-manager/Trunk.toml", "--port", "8082", "--dist", "target/dist-parts-manager"],
      "port": 8082
    },
    {
      "name": "parts-server",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "-p", "openecraft-parts-server", "--", "--token", "local-test-token", "--data", "target/parts-db-dev.sqlite"],
      "port": 8090
    },
    {
      "name": "parts-server-json",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "-p", "openecraft-parts-server", "--", "--token", "local-test-token", "--data", "target/parts-db-dev.json"],
      "port": 8090
    }
  ]
}
